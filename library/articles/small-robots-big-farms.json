        "ready": { "zh": "成熟的", "pos": "adj.", "ipa": "/ˈredi/" }
      }
    },
    {
      "en": "The machine is cheap, light, and easy to repair.",
      "zh": "这台机器便宜、轻便，而且容易维修。",
      "words": {
        "machine": { "zh": "机器", "pos": "n.", "ipa": "/məˈʃiːn/" },
