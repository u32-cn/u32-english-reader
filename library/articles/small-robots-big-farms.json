      "words": {
        "farm": { "zh": "农场", "pos": "n.", "ipa": "/fɑːrm/" },
        "robot": { "zh": "机器人", "pos": "n.", "ipa": "/ˈroʊbɑːt/" },
        "slowly": { "zh": "缓慢地", "pos": "adv.", "ipa": "/ˈsloʊli/" },
        "between": { "zh": "在……之间", "pos": "prep.", "ipa": "/bɪˈtwiːn/" },
        "rows": { "zh": "成排的东西；一排", "pos": "n.", "ipa": "/roʊz/" }
      }
    },
    {
